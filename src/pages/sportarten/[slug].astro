---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Galerie from '../../components/Galerie.astro';
import Heimspiele from '../../components/Heimspiele.astro';
import {
  sparten,
  mannschaften,
  standDerDaten,
  fussballDeLink,
  fussballDeVerein,
  type Sparte,
} from '../../data/verein';

import fussballKopf from '../../assets/fotos/fussball-duell.jpg';
import teamHerren from '../../assets/fotos/teams/herren.jpg';
import teamDamen from '../../assets/fotos/teams/damen.jpg';
import teamAJugend from '../../assets/fotos/teams/a-jugend.jpg';
import teamCJugend from '../../assets/fotos/teams/c-jugend.jpg';
import g1 from '../../assets/fotos/galerie-fussball/1.jpg';
import g2 from '../../assets/fotos/galerie-fussball/2.jpg';
import g3 from '../../assets/fotos/galerie-fussball/3.jpg';
import g4 from '../../assets/fotos/galerie-fussball/4.jpg';
import g5 from '../../assets/fotos/galerie-fussball/5.jpg';
import g6 from '../../assets/fotos/galerie-fussball/6.jpg';
import g7 from '../../assets/fotos/galerie-fussball/7.jpg';
import g8 from '../../assets/fotos/galerie-fussball/8.jpg';

export function getStaticPaths() {
  return sparten.map((sparte) => ({
    params: { slug: sparte.slug },
    props: { sparte },
  }));
}

interface Props { sparte: Sparte }
const { sparte } = Astro.props;
const istFussball = sparte.slug === 'fussball';

// Bildmaterial – bisher nur fuer den Fussball vorhanden.
const kopfBilder: Record<string, ImageMetadata> = { fussball: fussballKopf };
const bild = kopfBilder[sparte.slug];

const teamBilder: Record<string, ImageMetadata> = {
  Herren: teamHerren,
  Damen: teamDamen,
  'A-Jugend': teamAJugend,
  'C-Jugend': teamCJugend,
};

const galerien: Record<string, { bild: ImageMetadata; alt: string }[]> = {
  fussball: [
    { bild: g1, alt: 'Spieler der A-Jugend beim Torschuss' },
    { bild: g2, alt: 'Zweikampf auf dem Sportplatz' },
    { bild: g3, alt: 'Spielerin der Damenmannschaft am Ball' },
    { bild: g4, alt: 'Nachwuchsspieler der C-Jugend' },
    { bild: g5, alt: 'Spielerin im Abendlicht auf dem Platz' },
    { bild: g6, alt: 'Die Mannschaft beim Warmmachen' },
    { bild: g7, alt: 'Herrenspieler mit Ball' },
    { bild: g8, alt: 'Spielszene der C-Jugend' },
  ],
};
const galerie = galerien[sparte.slug] ?? [];

const ankerId = (name: string) => 'team-' + name.toLowerCase().replace('ä', 'ae').replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout
  title={sparte.name}
  description={`${sparte.name} beim SC Norddörfer auf Sylt. ${sparte.kurz}`}
>
  <article class:list={['sparte', `sparte--${sparte.farbe}`]}>
    <!-- Kopf -->
    <header class="kopf">
      <div class="kopf__medium" aria-hidden="true">
        {bild ? (
          <Image src={bild} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
        ) : (
          <span class="kopf__muster"></span>
        )}
        <span class="kopf__schleier"></span>
      </div>

      <div class="container kopf__inhalt">
        <nav class="brotkrumen" aria-label="Sie sind hier">
          <ol>
            <li><a href="/">Start</a></li>
            <li><a href="/sportarten/">Sportarten</a></li>
            <li aria-current="page">{sparte.name}</li>
          </ol>
        </nav>

        <span class="kopf__chip"><Icon name={sparte.icon} aria-hidden="true" /></span>
        <h1>{sparte.name}</h1>
        <p class="kopf__kurz">{sparte.detail?.intro ?? sparte.kurz}</p>
      </div>
    </header>

    <!-- Eckdaten -->
    <section class="eckdaten" aria-label="Die wichtigsten Angaben">
      <div class="container eckdaten__grid">
        <div class="eckdatum">
          <Icon name="tabler:clock" aria-hidden="true" />
          <dl><dt>Wann</dt><dd>{sparte.zeitKurz}</dd></dl>
        </div>
        <div class="eckdatum">
          <Icon name="tabler:map-pin" aria-hidden="true" />
          <dl><dt>Wo</dt><dd>{sparte.ort}</dd></dl>
        </div>
        <div class="eckdatum">
          <Icon name="tabler:users" aria-hidden="true" />
          <dl><dt>Für wen</dt><dd>{sparte.alter}</dd></dl>
        </div>
        <div class="eckdatum">
          <Icon name="tabler:user-heart" aria-hidden="true" />
          <dl><dt>Ansprechpartner</dt><dd>{sparte.ansprechpartner}</dd></dl>
        </div>
      </div>
    </section>

    {istFussball ? (
      <!-- Fussball: jede Mannschaft mit eigenem Bereich -->
      <section class="section teams" id="mannschaften">
        <div class="container">
          <div class="teams__kopf">
            <h2>Unsere Mannschaften</h2>
            <p>Sieben Mannschaften von den Herren bis zur G-Jugend. Spring direkt zu deinem Team.</p>
          </div>

          <nav class="sprung" aria-label="Zu einer Mannschaft springen">
            {mannschaften.map((m) => (
              <a href={`#${ankerId(m.name)}`} class:list={[m.sucht && 'sprung--sucht']}>{m.name}</a>
            ))}
          </nav>

          <div class="teamliste">
            {mannschaften.map((m) => (
              <article class:list={['team', m.sucht && 'team--sucht']} id={ankerId(m.name)}>
                <figure class="team__bild">
                  {teamBilder[m.name] ? (
                    <Image src={teamBilder[m.name]} alt={`Die ${m.name} des SC Norddörfer`} widths={[420, 760]} sizes="(min-width: 60rem) 34vw, 92vw" loading="lazy" />
                  ) : (
                    <span class="team__muster" aria-hidden="true"></span>
                  )}
                </figure>

                <div class="team__text">
                  <h3>{m.name}</h3>
                  <p class="team__liga">
                    {m.sucht ? 'Pausiert – Trainer:in gesucht' : (m.liga ?? 'Kein Ligabetrieb')}
                  </p>

                  {m.sucht ? (
                    <div class="team__sucht">
                      <p>
                        Die F-Jugend pausiert, weil uns eine Trainerin oder ein Trainer fehlt. Wer
                        Lust hat, die Jahrgänge {m.jahrgang} wieder auf den Platz zu bringen, meldet
                        sich am besten direkt beim Verein.
                      </p>
                      <a class="btn btn--gold" href="/mitmachen/">Trainer:in werden</a>
                    </div>
                  ) : (
                    <div class="team__spalten">
                      <div class="kasten">
                        <h4><Icon name="tabler:calendar" aria-hidden="true" />Training</h4>
                        <ul class="zeiten">{m.zeiten.map((z) => <li>{z}</li>)}</ul>
                        <p class="kasten__fuss">Jahrgänge: {m.jahrgang}</p>
                      </div>

                      <div class="kasten kasten--kontakt">
                        <h4><Icon name="tabler:user-heart" aria-hidden="true" />Trainer</h4>
                        <p class="kontakt__name">{m.trainer}</p>
                        {m.telefon && (
                          <a class="kontakt__tel" href={`tel:${m.telefon.replace(/\s/g, '')}`}>
                            <Icon name="tabler:phone" aria-hidden="true" />
                            {m.telefon}
                          </a>
                        )}
                      </div>
                    </div>
                  )}

                  {m.fussballDe && (
                    <a
                      class="team__tabelle"
                      href={fussballDeLink(m.fussballDe.pfad, m.fussballDe.teamId)}
                      target="_blank"
                      rel="noopener"
                    >
                      <Icon name="tabler:table" aria-hidden="true" />
                      <span>Tabelle und Spielplan auf fussball.de</span>
                      <Icon name="tabler:external-link" aria-hidden="true" />
                    </a>
                  )}

                  {m.ohneLiga && (
                    <p class="team__ohneLiga">
                      Die G-Jugend spielt noch keinen Ligabetrieb – hier geht es ums Kicken, nicht um Punkte.
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>
    ) : (
      <!-- Alle anderen Sparten: Fliesstext mit Seitenspalte -->
      <div class="section">
        <div class="container inhalt">
          <div class="inhalt__text">
            {sparte.detail ? (
              sparte.detail.abschnitte.map((a) => (
                <section class="block">
                  <h2>{a.titel}</h2>
                  {a.absaetze.map((t) => <p>{t}</p>)}
                </section>
              ))
            ) : (
              <section class="block">
                <h2>Über {sparte.name}</h2>
                <p>{sparte.kurz}</p>
              </section>
            )}

            {sparte.detail?.zitat && (
              <blockquote class="zitat">
                <p>{sparte.detail.zitat.text}</p>
                <cite>{sparte.detail.zitat.quelle}</cite>
              </blockquote>
            )}

            {sparte.detail?.hinweis && (
              <aside class="hinweis">
                <Icon name="tabler:alert-circle" aria-hidden="true" />
                <div>
                  <h2>{sparte.detail.hinweis.titel}</h2>
                  <p>{sparte.detail.hinweis.text}</p>
                </div>
              </aside>
            )}
          </div>

          <aside class="inhalt__spalte">
            <div class="kasten">
              <h4><Icon name="tabler:calendar" aria-hidden="true" />Trainingszeiten</h4>
              <ul class="zeiten">{sparte.zeiten.map((z) => <li>{z}</li>)}</ul>
              <p class="kasten__fuss">{sparte.ort}</p>
            </div>

            {sparte.detail?.mitbringen && (
              <div class="kasten">
                <h4><Icon name="tabler:backpack" aria-hidden="true" />Was bringe ich mit?</h4>
                <ul class="haken">
                  {sparte.detail.mitbringen.map((m) => (
                    <li><Icon name="tabler:check" aria-hidden="true" />{m}</li>
                  ))}
                </ul>
              </div>
            )}

            <div class="kasten kasten--kontakt">
              <h4><Icon name="tabler:user-heart" aria-hidden="true" />Dein Kontakt</h4>
              <p class="kontakt__name">{sparte.ansprechpartner}</p>
              {sparte.telefon ? (
                <a class="kontakt__tel" href={`tel:${sparte.telefon.replace(/\s/g, '')}`}>
                  <Icon name="tabler:phone" aria-hidden="true" />
                  {sparte.telefon}
                </a>
              ) : (
                <p class="kontakt__offen">Kontaktdaten folgen</p>
              )}
            </div>
          </aside>
        </div>
      </div>
    )}

    <Galerie titel={`${sparte.name} in Bildern`} bilder={galerie} sparte={sparte.name} />

    {istFussball && <Heimspiele />}

    <div class="stand-leiste">
      <div class="container">
        <p class="stand">Stand: {standDerDaten}</p>
      </div>
    </div>

    <!-- Schnuppern -->
    <section class="schnuppern">
      <div class="container schnuppern__inhalt">
        <div>
          <h2>Einfach vorbeikommen</h2>
          <p>
            Du musst dich nicht anmelden und nichts bezahlen, um es auszuprobieren.
            Komm zur Trainingszeit vorbei und mach mit. Mitglied wirst du erst, wenn du
            regelmäßig dabei bist.
          </p>
        </div>
        <div class="cluster">
          <a class="btn btn--gold" href="/mitglied-werden/">Mitglied werden</a>
          <a class="btn btn--ghost" href="/trainingszeiten/">Alle Trainingszeiten</a>
        </div>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  .sparte { --akzent: var(--scn-red); --akzent-text: var(--scn-red); }
  .sparte--blau { --akzent: var(--scn-blue); --akzent-text: var(--scn-blue); }
  .sparte--gold { --akzent: var(--scn-gold); --akzent-text: var(--scn-gold-dark); }

  /* ---------- Kopf ---------- */
  .kopf {
    position: relative;
    isolation: isolate;
    color: #fff;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }
  .kopf__medium { position: absolute; inset: 0; z-index: -1; background: var(--akzent); }
  .kopf__medium :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .kopf__muster {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,0.1) 0 18px, rgba(255,255,255,0) 18px 36px),
      var(--akzent);
  }
  .kopf__schleier {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(11,23,32,0.82), rgba(11,23,32,0.45) 60%, rgba(11,23,32,0.25));
  }
  .kopf__inhalt { position: relative; }

  .brotkrumen { margin-bottom: 1.8rem; }
  .brotkrumen ol {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.75rem;
    list-style: none; margin: 0; padding: 0;
    font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
  }
  .brotkrumen li + li::before { content: '›'; margin-right: 0.75rem; opacity: 0.6; }
  .brotkrumen a { text-decoration: none; }
  .brotkrumen a:hover { color: var(--scn-gold); }
  .brotkrumen [aria-current='page'] { color: #fff; }

  .kopf__chip {
    display: grid; place-items: center;
    width: 62px; height: 62px;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: #fff;
    color: var(--akzent-text);
    font-size: 2rem;
  }
  .kopf h1 { font-size: var(--step-4); margin-bottom: 1rem; }
  .kopf__kurz {
    font-size: var(--step-1); line-height: 1.5; max-width: 56ch;
    color: rgba(255, 255, 255, 0.92);
  }

  /* ---------- Eckdaten ---------- */
  .eckdaten { background: var(--ink); color: var(--text-on-dark); }
  .eckdaten__grid { display: grid; gap: 1px; padding-block: 0; }
  @media (min-width: 40rem) { .eckdaten__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 68rem) { .eckdaten__grid { grid-template-columns: repeat(4, 1fr); } }

  .eckdatum {
    display: flex; align-items: flex-start; gap: 0.8rem;
    padding: 1.4rem clamp(0.5rem, 1.5vw, 1.4rem);
    position: relative;
  }
  .eckdatum + .eckdatum::before {
    content: ''; position: absolute;
    left: 0; top: 1.2rem; bottom: 1.2rem; width: 1px;
    background: var(--line-dark);
  }
  @media (max-width: 39.99rem) {
    .eckdatum + .eckdatum::before { left: 0; right: 0; top: 0; bottom: auto; width: auto; height: 1px; }
  }
  .eckdatum [data-icon] { color: var(--scn-gold); font-size: 1.35rem; flex: none; margin-top: 0.1rem; }
  .eckdatum dl { margin: 0; }
  .eckdatum dt {
    font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-on-dark-muted); margin-bottom: 0.15rem;
  }
  .eckdatum dd { margin: 0; font-weight: 600; font-size: 0.95rem; line-height: 1.35; }

  /* ---------- Fliesstext ---------- */
  .inhalt { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 62rem) { .inhalt { grid-template-columns: minmax(0, 1fr) 21rem; } }

  .block { margin-bottom: 2.6rem; }
  .block:last-child { margin-bottom: 0; }
  .block h2 {
    font-size: var(--step-2); margin-bottom: 0.9rem; padding-top: 1rem;
    border-top: 3px solid var(--akzent); display: inline-block;
  }
  .block p { font-size: 1.05rem; line-height: 1.7; max-width: 62ch; }

  .zitat { margin: 2.6rem 0; padding: 1.6rem 0 1.6rem 1.6rem; border-left: 4px solid var(--akzent); }
  .zitat p {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--step-2); line-height: 1.05; margin-bottom: 0.7rem;
  }
  .zitat cite { font-style: normal; font-size: 0.85rem; color: var(--text-muted); }

  .hinweis {
    display: flex; gap: 1rem; margin-top: 2.6rem; padding: 1.3rem 1.4rem;
    background: var(--sand); border-radius: var(--radius-lg); border-left: 4px solid var(--akzent);
  }
  .hinweis [data-icon] { color: var(--akzent-text); font-size: 1.4rem; flex: none; }
  .hinweis h2 { font-size: 1.3rem; margin-bottom: 0.35rem; }
  .hinweis p { font-size: 0.95rem; margin: 0; }

  .inhalt__spalte { display: grid; gap: 1.1rem; align-content: start; }

  /* ---------- Kaesten (Seitenspalte und Mannschaften) ---------- */
  .kasten { padding: 1.3rem 1.4rem 1.5rem; background: var(--sand); border-radius: var(--radius-lg); }
  .kasten h4 {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: 1.25rem; line-height: 1; margin: 0 0 0.9rem;
  }
  .kasten h4 [data-icon] { color: var(--akzent-text); font-size: 1.2rem; }

  .zeiten, .haken { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .zeiten li {
    font-size: 0.95rem; font-weight: 600;
    padding-bottom: 0.55rem; border-bottom: 1px solid var(--line);
  }
  .zeiten li:last-child { border-bottom: 0; padding-bottom: 0; }
  .kasten__fuss { margin-top: 0.9rem; font-size: 0.82rem; color: var(--text-muted); }

  .haken li { display: flex; gap: 0.5rem; font-size: 0.95rem; }
  .haken [data-icon] { color: var(--akzent-text); flex: none; margin-top: 0.2rem; }

  .kasten--kontakt { background: var(--ink); color: var(--text-on-dark); }
  .kasten--kontakt h4 [data-icon] { color: var(--scn-gold); }
  .kontakt__name { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.6rem; }
  .kontakt__tel {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-weight: 700; text-decoration: none; color: var(--scn-gold);
  }
  .kontakt__tel:hover { text-decoration: underline; text-underline-offset: 4px; }
  .kontakt__offen { font-size: 0.9rem; color: var(--text-on-dark-muted); margin: 0; }

  /* ---------- Mannschaften ---------- */
  .teams__kopf { margin-bottom: 1.5rem; }
  .teams__kopf h2 { font-size: var(--step-3); margin-bottom: 0.5rem; }
  .teams__kopf p { color: var(--text-muted); margin: 0; }

  .sprung {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .sprung a {
    padding: 0.45em 0.95em;
    background: var(--sand);
    border-radius: 99px;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.04em;
    text-decoration: none; color: inherit;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .sprung a:hover { background: var(--scn-red); color: #fff; }
  .sprung--sucht { color: var(--scn-red) !important; }
  .sprung--sucht:hover { color: #fff !important; }

  .teamliste { display: grid; }
  /* Trennstrich zwischen den Mannschaften – hilft vor allem hochkant
     bei der Zuordnung, wo eine Mannschaft aufhoert und die naechste beginnt. */
  .teamliste > .team + .team {
    margin-top: clamp(2.2rem, 4.5vw, 3.5rem);
    padding-top: clamp(2.2rem, 4.5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .team { display: grid; gap: 1.5rem; }
  @media (min-width: 60rem) { .team { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2.5rem; align-items: start; } }

  .team__bild { margin: 0; border-radius: var(--radius-lg); overflow: hidden; position: relative; background: var(--scn-red); }
  .team__bild :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .team__muster {
    display: block; width: 100%; aspect-ratio: 4 / 3;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,0.12) 0 16px, rgba(255,255,255,0) 16px 32px),
      var(--scn-red);
  }
  .team--sucht .team__bild, .team--sucht .team__muster { background-color: var(--ink); }

  .team__text h3 { font-size: var(--step-2); margin-bottom: 0.25rem; }
  .team__liga {
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 1.2rem;
  }
  .team--sucht .team__liga { color: var(--scn-red); }

  .team__spalten { display: grid; gap: 1rem; margin-bottom: 1.2rem; }
  @media (min-width: 40rem) { .team__spalten { grid-template-columns: 1.2fr 1fr; } }

  .team__sucht { display: grid; gap: 1rem; justify-items: start; margin-bottom: 1.2rem; }
  .team__sucht p { max-width: 56ch; }

  .team__tabelle {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.7em 1.1em;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    font-size: 0.86rem; font-weight: 600; text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .team__tabelle:hover { border-color: var(--scn-red); transform: translateY(-1px); }
  .team__tabelle [data-icon]:first-child { color: var(--scn-red); font-size: 1.1rem; }
  .team__tabelle [data-icon]:last-child { font-size: 0.95rem; color: var(--text-muted); }

  .team__ohneLiga { font-size: 0.9rem; color: var(--text-muted); margin: 0; }


  /* ---------- Schnuppern ---------- */
  .schnuppern { background: var(--scn-blue); color: #fff; padding-block: clamp(2.5rem, 5vw, 4rem); }
  .schnuppern__inhalt { display: grid; gap: 1.8rem; align-items: center; }
  @media (min-width: 62rem) { .schnuppern__inhalt { grid-template-columns: 1.4fr 1fr; } }
  .schnuppern h2 { font-size: var(--step-2); margin-bottom: 0.7rem; }
  .schnuppern p { color: rgba(255, 255, 255, 0.88); max-width: 56ch; margin: 0; }

  /* Schliesst optisch an die Galerie darueber an */
  .stand-leiste { background: var(--sand); }
