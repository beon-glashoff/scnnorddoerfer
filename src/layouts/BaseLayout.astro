---
import '@fontsource/anton';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { verein } from '../data/verein';

interface Props {
  title: string;
  description: string;
  /** Header liegt transparent über einem Bild (Startseite) */
  transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;
const fullTitle = `${title} | ${verein.kurzname}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1720" />
    <link rel="icon" href="/wappen-scn.png" type="image/png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={verein.kurzname} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
  </head>
  <body>
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>
    <Header transparent={transparentHeader} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translate(-50%, -140%);
        z-index: 200;
        background: var(--scn-gold);
        color: var(--ink);
        font-weight: 700;
        padding: 0.7em 1.4em;
        text-decoration: none;
        transition: transform 0.2s ease;
      }
      .skip:focus { transform: translate(-50%, 0); }
    </style>
  </body>
</html>
