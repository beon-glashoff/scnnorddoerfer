---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  titel: string;
  bilder: { bild: ImageMetadata; alt: string }[];
  /** Name der Sparte fuer den Platzhaltertext */
  sparte: string;
}
const { titel, bilder, sparte } = Astro.props;

// Alle Bilder stehen gleich hoch, die Breite ergibt sich aus dem Seitenverhaeltnis.
// Die Hoehe in `sizes` muss zu --galerie-hoehe im Stil passen: min(52vw, 20rem),
// ab 615px Viewport-Breite also fest 320px.
const sizes = (b: ImageMetadata) => {
  const verhaeltnis = b.width / b.height;
  return `(min-width: 615px) ${Math.round(320 * verhaeltnis)}px, ${Math.round(52 * verhaeltnis)}vw`;
};
---

<section class="section section--sand galerie">
  <div class="container">
    <div class="galerie__kopf">
      <h2>{titel}</h2>
      {bilder.length > 0 && <p class="galerie__hinweis">Zum Blättern wischen oder scrollen.</p>}
    </div>

    {bilder.length > 0 ? (
      <ul class="spur">
        {bilder.map((b) => (
          <li>
            <Image src={b.bild} alt={b.alt} widths={[420, 760]} sizes={sizes(b.bild)} loading="lazy" />
          </li>
        ))}
      </ul>
    ) : (
      <div class="platz">
        <Icon name="tabler:photo" aria-hidden="true" />
        <p><strong>Hier kommen Fotos vom {sparte} hin.</strong></p>
        <p class="klein">Die Aufnahmen sind beauftragt und werden nachgereicht.</p>
      </div>
    )}
  </div>
</section>

<style>
  .galerie__kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-bottom: 1.4rem;
  }
  .galerie__kopf h2 { font-size: var(--step-2); }
  .galerie__hinweis { font-size: 0.82rem; color: var(--text-muted); margin: 0; }

  /* Waagerechte Spur mit Einrasten – braucht kein JavaScript.
     Alle Bilder sind gleich hoch und werden ungeschnitten gezeigt: Querformate
     laufen breit, Hochformate schmal. Ein Querformat in 3:2 misst so wie bisher
     min(78vw, 30rem) in der Breite. */
  .spur {
    --galerie-hoehe: min(52vw, 20rem);
    list-style: none;
    margin: 0;
    padding: 0 0 0.8rem;
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .spur li { flex: none; scroll-snap-align: start; }
  .spur :global(img) {
    display: block;
    height: var(--galerie-hoehe);
    width: auto;
    max-width: none;
    border-radius: var(--radius-lg);
  }

  .platz {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.3rem;
    padding: clamp(2rem, 5vw, 3.2rem) 1.5rem;
    border: 2px dashed rgba(11, 23, 32, 0.2);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
  }
  .platz [data-icon] { font-size: 2.1rem; color: var(--scn-blue); margin-bottom: 0.4rem; }
  .platz p { margin: 0; }
  .platz .klein { font-size: 0.87rem; }
</style>
