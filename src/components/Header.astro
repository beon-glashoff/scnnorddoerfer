---
import { Icon } from 'astro-icon/components';
import { navigation, verein } from '../data/verein';

interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const pfad = Astro.url.pathname;
---

<header class:list={['kopf', transparent && 'kopf--transparent']} data-kopf>
  <div class="kopf__inner container">
    <a href="/" class="marke" aria-label={`${verein.kurzname} – zur Startseite`}>
      <img src="/wappen-scn.png" alt="" width="52" height="50" />
      <span class="marke__text">SC Norddörfer</span>
    </a>

    <div class="kopf__rechts">
      <nav class="nav" aria-label="Hauptnavigation">
        <ul>
          {navigation.map((eintrag) => (
            <li>
              <a href={eintrag.href} aria-current={pfad.startsWith(eintrag.href) ? 'page' : undefined}>
                {eintrag.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <button type="button" class="burger" aria-expanded="false" aria-controls="mobilnav" data-burger>
        <Icon name="tabler:menu-2" class="burger__auf" aria-hidden="true" />
        <Icon name="tabler:x" class="burger__zu" aria-hidden="true" />
        <span class="visually-hidden" data-burger-text>Menü öffnen</span>
      </button>
    </div>
  </div>

  <div class="mobilnav" id="mobilnav" hidden data-mobilnav>
    <ul>
      {navigation.map((eintrag) => (
        <li><a href={eintrag.href}>{eintrag.label}</a></li>
      ))}
    </ul>
  </div>
  <div class="band band--full" aria-hidden="true"><span></span><span></span><span></span></div>
</header>

<style>
  .kopf {
    --wappen: 44px;
    --kopf-hoehe: 74px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    transition: background-color 0.3s ease;
  }

  /* Ueber dem Held darf das Wappen gross auftreten und schrumpft
     beim Scrollen auf das Mass der uebrigen Seiten zurueck. */
  .kopf--transparent { --wappen: 62px; --kopf-hoehe: 96px; }
  .kopf--transparent.ist-gescrollt { --wappen: 44px; --kopf-hoehe: 74px; }
  .kopf--transparent {
    position: fixed;
    top: 0;
    inset-inline: 0;
    background: linear-gradient(to bottom, rgba(11, 23, 32, 0.78), rgba(11, 23, 32, 0));
  }
  .kopf--transparent.ist-gescrollt {
    background: var(--ink);
    box-shadow: 0 6px 24px -12px rgba(0, 0, 0, 0.8);
  }
  .kopf--transparent .band { opacity: 0; transition: opacity 0.3s ease; }
  .kopf--transparent.ist-gescrollt .band { opacity: 1; }

  .kopf__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--kopf-hoehe);
    transition: min-height 0.3s ease;
  }

  .marke { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .marke img {
    width: var(--wappen);
    height: auto;
    transition: width 0.3s ease;
  }
  .marke__text {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.28rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    line-height: 1;
  }

  /* Navigation sitzt rechtsbuendig am Ende der Zeile und laeuft ueber die
     volle Kopfhoehe - nur so kann die Markierung ganz oben am Rand sitzen. */
  .kopf__rechts {
    display: flex;
    align-self: stretch;
    align-items: stretch;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .nav { display: none; }
  .nav ul {
    display: flex;
    height: 100%;
    gap: clamp(1.1rem, 2.4vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav li { display: flex; }
  .nav a {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    position: relative;
    white-space: nowrap;
  }
  /* Markierung sitzt als Overline ganz oben am Bildschirmrand */
  .nav a::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: var(--scn-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }
  .nav a:hover::before,
  .nav a[aria-current='page']::before { transform: scaleX(1); }

  .burger {
    align-self: center;
    display: inline-grid;
    place-items: center;
    width: 44px; height: 44px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 1.5rem;
  }
  /* Bei geoeffnetem Menue wird aus dem Burger ein Kreuz */
  .burger__zu { display: none; }
  .burger[aria-expanded='true'] .burger__auf { display: none; }
  .burger[aria-expanded='true'] .burger__zu { display: block; }

  .mobilnav { background: var(--ink); border-top: 1px solid var(--line-dark); }
  .mobilnav ul { list-style: none; margin: 0; padding: 0.5rem var(--gutter) 1.5rem; display: grid; gap: 0.2rem; }
  .mobilnav a {
    display: block;
    padding: 0.85em 0;
    text-decoration: none;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.5rem;
    border-bottom: 1px solid var(--line-dark);
  }

  @media (min-width: 60rem) {
    .nav { display: block; }
    .burger { display: none; }
    .kopf { --wappen: 52px; }
    .kopf--transparent { --wappen: 92px; --kopf-hoehe: 124px; }
    .kopf--transparent.ist-gescrollt { --wappen: 52px; --kopf-hoehe: 74px; }
  }
</style>

<script>
  const kopf = document.querySelector('[data-kopf]');
  const burger = document.querySelector('[data-burger]');
  const mobilnav = document.querySelector('[data-mobilnav]');

  if (kopf?.classList.contains('kopf--transparent')) {
    const beobachter = () => kopf.classList.toggle('ist-gescrollt', window.scrollY > 40);
    beobachter();
    window.addEventListener('scroll', beobachter, { passive: true });
  }

  const burgerText = burger?.querySelector('[data-burger-text]');

  burger?.addEventListener('click', () => {
    const offen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!offen));
    if (mobilnav instanceof HTMLElement) mobilnav.hidden = offen;
    if (burgerText) burgerText.textContent = offen ? 'Menü öffnen' : 'Menü schließen';
  });
</script>
