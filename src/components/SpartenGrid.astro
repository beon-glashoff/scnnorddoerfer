---
import { sparten } from '../data/verein';
import SpartenKarte from './SpartenKarte.astro';
---

<section class="section section--sand" id="sportarten">
  <div class="container">
    <div class="sparten__kopf reveal">
      <div class="section-head">
        <p class="eyebrow">Alle Sparten</p>
        <h2>Für jede:n<br />das Richtige</h2>
        <p class="lead">
          In jedes Training &amp; jeden Kurs kannst du ohne Anmeldung reinschnuppern.
        </p>
      </div>
      <div class="band" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>

    <ul class="sparten reveal">
      {sparten.map((s) => (
        <li><SpartenKarte sparte={s} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sparten__kopf { display: grid; gap: 1.6rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .sparten__kopf h2 { font-size: var(--step-4); }

  .sparten {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
</style>
