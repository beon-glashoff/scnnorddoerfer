---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heroBild from '../assets/fotos/hero-team.jpg';
---

<section class="held">
  <Image
    src={heroBild}
    alt="Spieler des SC Norddörfer im Trikot mit der Nummer 5 schießt den Ball"
    class="held__bild"
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="held__schleier" aria-hidden="true"></div>

  <div class="container held__inhalt">
    <h1 class="held__titel">
      <span>Eine Insel,</span>
      <span class="held__akzent">ein Verein.</span>
    </h1>

    <p class="held__text">
      Acht Sportarten, sieben Fußballmannschaften. Das ist der SC Norddörfer auf Sylt.
      Komm einfach vorbei – bei uns kannst du in jedes Training reinschnuppern,
      ganz ohne Anmeldung.
    </p>

    <div class="cluster held__aktionen">
      <a class="btn btn--gold" href="#sportarten">
        Sportarten entdecken
        <Icon name="tabler:arrow-down" aria-hidden="true" />
      </a>
      <a class="btn btn--ghost" href="#news">
        News
        <Icon name="tabler:arrow-down" aria-hidden="true" />
      </a>
    </div>
  </div>

  <a class="held__weiter" href="#fussball" aria-label="Weiter zum Fußball">
    <Icon name="tabler:chevron-down" aria-hidden="true" />
  </a>
</section>

<style>
  .held {
    position: relative;
    min-height: min(100svh, 920px);
    display: grid;
    align-items: end;
    padding-block: 9rem clamp(3.5rem, 8vw, 6rem);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .held__bild {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    z-index: -2;
  }

  .held__schleier {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(11, 23, 32, 0.94) 0%, rgba(11, 23, 32, 0.55) 42%, rgba(11, 23, 32, 0.15) 75%),
      linear-gradient(to right, rgba(11, 23, 32, 0.88) 0%, rgba(11, 23, 32, 0.45) 38%, rgba(11, 23, 32, 0) 68%);
  }

  .held__titel {
    font-size: var(--step-5);
    line-height: 0.86;
    max-width: 14ch;
    margin-bottom: 1.5rem;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.45);
  }
  .held__titel span { display: block; }
  .held__akzent { color: var(--scn-gold); }

  .held__text {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
  }

  .held__aktionen { gap: 0.9rem; }

  .held__weiter {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 46px; height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 1.4rem;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .held__weiter { animation: huepf 2.4s ease-in-out infinite; }
    @keyframes huepf {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 7px); }
    }
  }
  @media (max-width: 48rem) {
    .held__weiter { display: none; }
    /* Hochkant steht der Text staerker im Motiv - Schleier kraeftiger ziehen */
    .held__schleier {
      background:
        linear-gradient(to top, rgba(11, 23, 32, 0.97) 0%, rgba(11, 23, 32, 0.82) 38%, rgba(11, 23, 32, 0.3) 72%, rgba(11, 23, 32, 0.1) 100%);
    }
    .held__text { font-size: var(--step-0); }
    .held { padding-block: 7rem 3rem; }
  }
</style>
