---
/**
 * Nachrichten-Feed von DeinSylt.
 * Embed-Code: ../../01_Assets/08_Sonstiges/DeinSylt_News_Widget_Embed.html
 *
 * Das Widget laedt ein Skript von dein-sylt.online nach und baut damit eine
 * Verbindung zu einem fremden Server auf. Das muss vor dem Launch in der
 * Datenschutzerklaerung stehen.
 */
---

<section class="section section--sand news" id="news">
  <div class="container">
    <div class="news__kopf">
      <div class="section-head">
        <p class="eyebrow">Aus dem Verein</p>
        <h2>Neues vom SCN</h2>
        <p class="lead">
          Berichte, Ergebnisse und Termine – eingebunden über den Nachrichten-Feed von DeinSylt.
        </p>
      </div>
    </div>

    <div class="news__feed">
      <div
        id="sylt-news-widget"
        data-query="SC Norddörfer"
        data-limit="14"
        data-border-color="#e3dcd0"
        data-link-color="#005ba7"
        data-button-color="#e30613"
        data-powered-color="#55636e"
      >
      </div>
    </div>
  </div>
</section>

<script is:inline src="https://www.dein-sylt.online/js/sylt-widget.js"></script>

<style>
  .news__kopf { margin-bottom: 2rem; }

  /* Das Widget bringt eigene Stile mit. Hier nur der Rahmen, damit es sich
     in die Seitenbreite einpasst und auf schmalen Schirmen nicht ausbricht. */
  .news__feed { max-width: 100%; }
  .news__feed :global(img) { max-width: 100%; height: auto; }

  /* Die globale Regel setzt alle h1-h4 in Anton und Versalien. Fuer
     Nachrichtenzeilen ist das zu laut - im Widget deshalb zuruecknehmen. */
  .news__feed :global(h3) {
    font-family: var(--font-text);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }
</style>
