---
import { Icon } from 'astro-icon/components';
import { wochenplan, standDerDaten } from '../data/verein';

interface Props {
  /** Auf der eigenen Unterseite uebernimmt der Seitenkopf die Ueberschrift. */
  ohneKopf?: boolean;
}
const { ohneKopf = false } = Astro.props;

const orte = [
  { name: 'Halle', klasse: 'halle' },
  { name: 'Platz', klasse: 'platz' },
  { name: 'Vereinsheim', klasse: 'vereinsheim' },
];
---

<section class="section section--sand" id="trainingszeiten">
  <div class="container">
    {!ohneKopf && (
      <div class="plan__kopf reveal">
        <div class="section-head">
          <p class="eyebrow">Trainingszeiten</p>
          <h2>Die Woche<br />beim SCN</h2>
          <p class="lead">
            Montag bis Freitag ist bei uns etwas los. Such dir raus, was passt, und komm vorbei.
          </p>
        </div>
      </div>
    )}

    <ul class="legende">
      {orte.map((o) => (
        <li><span class:list={['punkt', `punkt--${o.klasse}`]} aria-hidden="true"></span>{o.name}</li>
      ))}
    </ul>

    <div class="plan reveal">
      {wochenplan.map((tag) => (
        <div class="tag">
          <h3 class="tag__name">{tag.tag}</h3>
          <ul class="tag__liste">
            {tag.eintraege.map((e) => (
              <li>
                <a href={`/sportarten/${e.slug}/`}>
                  <span class="zeit">{e.zeit}</span>
                  <span class="was">{e.was}</span>
                  <span class:list={['ort', `ort--${e.ort.toLowerCase()}`]}>
                    <span class="punkt" aria-hidden="true"></span>{e.ort}
                  </span>
                  <Icon class="pfeil" name="tabler:arrow-right" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="plan__stand">Stand: {standDerDaten}</p>
  </div>
</section>

<style>
  .plan__kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.8rem;
    margin-bottom: clamp(2.2rem, 4vw, 3rem);
  }
  .plan__kopf h2 { font-size: var(--step-4); }

  /* ---------- Legende ---------- */
  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    margin: 0 0 1.4rem;
    padding: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .legende li { display: flex; align-items: center; gap: 0.45rem; }

  .punkt {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--scn-blue);
  }
  .punkt--platz, .ort--platz .punkt { background: var(--scn-red); }
  .punkt--vereinsheim, .ort--vereinsheim .punkt { background: var(--scn-gold-dark); }

  /* ---------- Wochenraster ---------- */
  .plan { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 52rem) { .plan { grid-template-columns: repeat(5, 1fr); gap: 0.9rem; } }

  .tag {
    background: var(--paper);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(11, 23, 32, 0.06);
  }

  .tag__name {
    background: var(--scn-gold);
    color: var(--ink);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    padding: 0.6rem 1rem;
    margin: 0;
  }

  .tag__liste { list-style: none; margin: 0; padding: 0.3rem 0 0.4rem; }
  .tag__liste li + li { border-top: 1px solid var(--line); }

  .tag a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.5rem;
    padding: 0.7rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.16s ease;
  }
  .tag a:hover { background: var(--sand); }

  .zeit {
    grid-column: 1 / -1;
    font-size: 0.76rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .was {
    grid-column: 1 / -1;
    font-weight: 600;
    font-size: 0.93rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .ort {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pfeil {
    align-self: end;
    justify-self: end;
    font-size: 0.95rem;
    color: var(--scn-red);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .tag a:hover .pfeil { opacity: 1; transform: none; }

  .plan__stand {
    margin-top: 1.8rem;
    text-align: right;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }
</style>
